{
  "name": "genika",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema modular de trazabilidad para devoluciones de materiales reciclables",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start:api": "npm --prefix backend start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
